# OpenRouter — one key, all panel models and all referees.
OPENROUTER_API_KEY=sk-or-v1-...

# Optional attribution headers OpenRouter shows on its dashboard.
OPENROUTER_APP_URL=http://localhost:3000
OPENROUTER_APP_TITLE=Delibrator

# MongoDB Atlas (free tier). Swap for mongodb://localhost:27017 with no code change.
MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=delibrator

# Set to 1 to serve every model call from the recorded completions cache.
# `make demo` uses this: full product, zero API keys.
DELIBRATOR_REPLAY=0
